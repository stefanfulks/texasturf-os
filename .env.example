# TexasTurf OS — environment template
# Copy to .env.local and fill in real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Supabase Auth provider)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: embed-friendly Google Calendar src for /calendar
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_SRC=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only — required for source-map upload to Sentry.
# Without this the Vercel build silently skips upload and prod
# stack traces stay minified.
SENTRY_AUTH_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
EMAIL_FROM=

# Monday.com
MONDAY_API_KEY=
MONDAY_FLEET_BOARD_ID=
MONDAY_INTERNAL_OPS_BOARD_ID=
MONDAY_INVOICE_BOARD_ID=

# Anthropic (powers the in-app /assistant)
ANTHROPIC_API_KEY=

# OpenAI (powers OCR; OCR_PROVIDER selects the implementation)
OPENAI_API_KEY=
OCR_PROVIDER=openai

# Slack (invoice intake + warehouse delivery posts + assistant write tools)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_INVOICE_CHANNEL_ID=
SLACK_WAREHOUSE_CHANNEL_ID=
# Vendor purchasing: daily digest target + (optional) #low-inventory source channel
SLACK_VENDOR_ORDER_CHANNEL_ID=
SLACK_LOW_INVENTORY_CHANNEL_ID=

# Vercel Cron — required by /api/cron/* routes (fail closed when unset)
CRON_SECRET=

# Notion (optional — lets the /assistant search SOPs in your Notion workspace)
# Create at notion.so/my-integrations, then share each SOP page with the integration.
NOTION_API_KEY=

# --- Jobber OAuth (clients + visits sync) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/callback
JOBBER_SCOPES=read_clients read_jobs read_visits read_properties read_users
# Jobber signs webhook bodies with the app secret (rotatable separately)
JOBBER_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# --- Twilio (Sales comms: click-to-call + 2-way SMS) ---
# Calling lights up as soon as the first three are set. SMS stays dark until
# TWILIO_MESSAGING_SERVICE_SID is also set (after A2P 10DLC is approved).
# All server-only — never commit real values; add to Vercel + .env.local only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The purchased TexasTurf number in E.164 (e.g. +14695551234) — used as caller ID.
TWILIO_PHONE_NUMBER=
# 10DLC-registered messaging service SID (starts MG...). Leave blank until 10DLC clears — SMS stays disabled.
TWILIO_MESSAGING_SERVICE_SID=
# Bridge target: the rep's mobile (E.164) that rings first on a click-to-call.
# v1 fallback for all reps; per-rep profiles.mobile is a future enhancement.
TWILIO_FALLBACK_REP_NUMBER=
